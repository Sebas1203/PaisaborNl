# Modo demo de Paisabor. Copia este archivo como .env.local (que NO se sube a git) para
# activar los botones "Entrar como cliente demo" y "Entrar como admin demo" en /login.
#
# Son cuentas ficticias que solo existen en el navegador (localStorage) mientras la app
# funciona sin backend. Nunca pongas aquí contraseñas reales: todo lo que empieza por
# NEXT_PUBLIC_ termina en el código que se descarga el navegador.

NEXT_PUBLIC_DEMO_MODE=true

NEXT_PUBLIC_DEMO_CLIENTE_EMAIL=cliente.demo@example.com
NEXT_PUBLIC_DEMO_CLIENTE_PASSWORD=demo-cliente-1234

NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin.demo@example.com
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=demo-admin-1234

# Fase de pruebas con usuarios.
# Barra "Prototipo de prueba", botón "Reiniciar datos de prueba" y noindex para buscadores.
# Está activo por defecto; ponlo en false solo cuando la tienda sea real.
NEXT_PUBLIC_PROTOTIPO=true
# Enlace opcional al formulario de comentarios (por ejemplo un Google Form). Solo https.
# Vacío: no se muestra el botón "Dejar comentarios".
NEXT_PUBLIC_FEEDBACK_URL=
